# Local development. Copy to .env and fill in the blanks. Never commit .env.

# docker compose reads these two for the Postgres and Redis containers it
# starts, and builds the api container's DATABASE_URL / REDIS_URL from them.
# Generate each with: openssl rand -hex 16
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Used when the API runs on the host (uvicorn / pytest) against the compose
# containers, which listen on 127.0.0.1:5433 and 127.0.0.1:6379. Put the same
# passwords here. Inside compose, the api service overrides both.
DATABASE_URL=postgresql+asyncpg://gateway:POSTGRES_PASSWORD@localhost:5433/gateway
REDIS_URL=redis://:REDIS_PASSWORD@localhost:6379/0
DEFAULT_ORG_ID=org_default
DEFAULT_ACTOR_ID=user_operator
# An email sign-up at this address becomes the first platform admin, while there is none.
SEED_USER_EMAIL=
SESSION_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://console.eisoptric.com,https://ops.eisoptric.com
# Public origin of this API. MCP OAuth callbacks use ${PUBLIC_WS_URL}/mcp-servers/oauth/callback.
# Production is https://api.eisoptric.com.
# PUBLIC_WS_URL=https://api.eisoptric.com
# GitHub OAuth App callback must be exactly ${PUBLIC_WS_URL}/mcp-servers/oauth/callback
# Google OAuth client redirect URI is the same callback.
# GATEWAY_GOOGLE_OAUTH_CLIENT_ID=
# GATEWAY_GOOGLE_OAUTH_CLIENT_SECRET=
# Leave unset/false in production. Tests set this so the policy loop can run without a live Agent.
# IN_PROCESS_RUNTIME=false
# ISO date (YYYY-MM-DD). Until it, legacy (pre-argon2) passwords can still sign in; empty means
# they never can. While it is in the future every failed sign-in also sends the legacy proofs,
# the raw password included, so set it only if accounts from before 2026-10-16 remain.
# LEGACY_PASSWORD_UNTIL=
# The container runs `alembic upgrade head` on start unless this is "false".
# Production sets it to false when migrations run in a Cloud Run Job.
# RUN_MIGRATIONS=true
# How long a migration waits for another runner's advisory lock (Postgres interval).
# MIGRATION_LOCK_WAIT=300s
# Optional: Claude via Anthropic Workload Identity Federation for policy drafting.
# On Cloud Run, fetches the OIDC ID token from the metadata server; locally, set
# ANTHROPIC_IDENTITY_TOKEN_FILE or GOOGLE_APPLICATION_CREDENTIALS.
# POLICY_LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_ORGANIZATION_ID=
# ANTHROPIC_FEDERATION_RULE_ID=
# ANTHROPIC_SERVICE_ACCOUNT_ID=
# ANTHROPIC_WORKSPACE_ID=
# ANTHROPIC_AUDIENCE=https://api.anthropic.com
